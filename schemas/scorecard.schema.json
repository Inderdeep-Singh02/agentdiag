{
  "$defs": {
    "EvalAggregate": {
      "description": "One Eval of one Scenario across that Scenario's Trials: what `compare` joins on.",
      "properties": {
        "abnormal": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "pass",
              "fail",
              "incomplete",
              "unverifiable",
              "invalid"
            ]
          },
          "title": "Abnormal",
          "type": "object"
        },
        "decidable": {
          "title": "Decidable",
          "type": "integer"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "minimize",
                "maximize"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "eval": {
          "title": "Eval",
          "type": "string"
        },
        "eval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Id"
        },
        "judged": {
          "default": false,
          "title": "Judged",
          "type": "boolean"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "value_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Mean"
        }
      },
      "required": [
        "eval",
        "decidable",
        "passed"
      ],
      "title": "EvalAggregate",
      "type": "object"
    },
    "NotRun": {
      "description": "A Scenario that a Suite declared and this Run did not execute (D31, ADR-0005 §3).\n\nEnumerated rather than omitted: \"nothing failed\" and \"nothing ran\" look identical in a\npass rate, and ADR-0005 §8 makes the Scorecard say which it was.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "reason": {
          "enum": [
            "not_selected",
            "suite_not_run",
            "fixture_unavailable",
            "cancelled"
          ],
          "title": "Reason",
          "type": "string"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "suite": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suite"
        },
        "trial": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trial"
        }
      },
      "required": [
        "scenario",
        "reason"
      ],
      "title": "NotRun",
      "type": "object"
    },
    "ScenarioAggregate": {
      "description": "One Scenario across its Trials, with its pass^k (ADR-0005 §7, ticket 08).",
      "properties": {
        "decidable": {
          "title": "Decidable",
          "type": "integer"
        },
        "evals": {
          "items": {
            "$ref": "#/$defs/EvalAggregate"
          },
          "title": "Evals",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "pass_k": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Pass K",
          "type": "object"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "suite": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suite"
        },
        "trials": {
          "title": "Trials",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "trials",
        "decidable",
        "passed"
      ],
      "title": "ScenarioAggregate",
      "type": "object"
    },
    "ScenarioLine": {
      "description": "One Trial of one Scenario, and the Scores it produced.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "scores": {
          "items": {
            "$ref": "#/$defs/ScoreLine"
          },
          "title": "Scores",
          "type": "array"
        },
        "trial": {
          "title": "Trial",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "trial"
      ],
      "title": "ScenarioLine",
      "type": "object"
    },
    "ScoreLine": {
      "description": "One Score as the Scorecard carries it: enough to read, not the whole Score.",
      "properties": {
        "eval": {
          "title": "Eval",
          "type": "string"
        },
        "eval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "incomplete",
            "unverifiable",
            "invalid"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "eval",
        "verdict"
      ],
      "title": "ScoreLine",
      "type": "object"
    },
    "SectionState": {
      "description": "One section's three hashes and what they say.",
      "properties": {
        "change": {
          "anyOf": [
            {
              "enum": [
                "changed",
                "added",
                "removed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change"
        },
        "deployed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployed"
        },
        "deployed_by": {
          "anyOf": [
            {
              "enum": [
                "local",
                "adapter",
                "connector"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployed By"
        },
        "direction": {
          "enum": [
            "identical",
            "local_ahead",
            "deployed_ahead",
            "diverged",
            "not_covered"
          ],
          "title": "Direction",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "prompt",
            "tool",
            "data_source",
            "model",
            "provider",
            "flow",
            "tier"
          ],
          "title": "Kind",
          "type": "string"
        },
        "local": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "recorded": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded"
        }
      },
      "required": [
        "id",
        "kind",
        "direction"
      ],
      "title": "SectionState",
      "type": "object"
    },
    "SyncSection": {
      "description": "The Sync a Run checked before its first Trial (ADR-0007, ADR-0008, D30).\n\n`fingerprint` is the id of the Fingerprint compared against; `resynced_from` is set when\nthe Run found Sync broken and rebuilt the Fingerprint (the default), so `show`, the\nScorecard's summary and the Report can say which sections moved before anything else\n(ADR-0008's \"never silent\"); `sections` are the broken ones.",
      "properties": {
        "connector_failed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connector Failed"
        },
        "covered_by": {
          "anyOf": [
            {
              "enum": [
                "local",
                "adapter",
                "connector"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covered By"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "no_manifest",
                "no_fingerprint",
                "adapter_cannot_observe"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "resynced_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resynced From"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/SectionState"
          },
          "title": "Sections",
          "type": "array"
        },
        "status": {
          "enum": [
            "held",
            "broken",
            "not_checked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "SyncSection",
      "type": "object"
    }
  },
  "description": "The aggregate of all Scores in a Run (`CONTEXT.md`, ADR-0005 §8).",
  "properties": {
    "cites_read": {
      "default": 0,
      "title": "Cites Read",
      "type": "integer"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "pass",
          "fail",
          "incomplete",
          "unverifiable",
          "invalid"
        ]
      },
      "title": "Counts",
      "type": "object"
    },
    "excluded_trials": {
      "default": 0,
      "title": "Excluded Trials",
      "type": "integer"
    },
    "not_run": {
      "items": {
        "$ref": "#/$defs/NotRun"
      },
      "title": "Not Run",
      "type": "array"
    },
    "pass_k": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Pass K",
      "type": "object"
    },
    "pass_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pass Rate"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_aggregates": {
      "items": {
        "$ref": "#/$defs/ScenarioAggregate"
      },
      "title": "Scenario Aggregates",
      "type": "array"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ScenarioLine"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "shared_model": {
      "default": false,
      "title": "Shared Model",
      "type": "boolean"
    },
    "simulated_user_sampling": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Simulated User Sampling"
    },
    "sync": {
      "$ref": "#/$defs/SyncSection"
    },
    "trials": {
      "title": "Trials",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "sync",
    "trials",
    "counts"
  ],
  "title": "Scorecard",
  "type": "object"
}
