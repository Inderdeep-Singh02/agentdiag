{
  "$defs": {
    "AdapterDescription": {
      "description": "An Adapter's own account of itself, recorded verbatim in `run.json`.\n\n`config` is the environment's block from the Manifest as written. Secrets never live\nin a Manifest, so nothing here needs redacting.",
      "properties": {
        "backend": {
          "anyOf": [
            {
              "$ref": "#/$defs/Backend"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "fidelity": {
          "enum": [
            "instrumented",
            "reconstructed",
            "observed"
          ],
          "title": "Fidelity",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "live_acknowledged": {
          "default": false,
          "title": "Live Acknowledged",
          "type": "boolean"
        },
        "observes": {
          "items": {
            "type": "string"
          },
          "title": "Observes",
          "type": "array"
        },
        "side_effects": {
          "enum": [
            "none",
            "sandboxed",
            "live"
          ],
          "title": "Side Effects",
          "type": "string"
        },
        "turn_timeout_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Timeout S"
        }
      },
      "required": [
        "kind",
        "fidelity",
        "side_effects",
        "environment"
      ],
      "title": "AdapterDescription",
      "type": "object"
    },
    "AgentdiagSection": {
      "description": "Which agentdiag, and which of the packages it drives models and files with.",
