    "JudgeConfiguration": {
      "description": "The `judge` block of `run.json`: which model, how hard, which prompts, which notes.\n\nThe full text, not a pointer: a Run is meant to be interpretable with no access to the\nagentdiag that produced it, and a prompt that changed between two Runs must be visible\nin a comparison rather than inferred from a version string. `overrides` names every\ndeclaration that asked for a Judge of its own (D14, D19), by its id or its Eval's name.",
      "properties": {
        "backend": {
          "anyOf": [
            {
              "$ref": "#/$defs/Backend"
            },
            {
              "type": "null"
            }
